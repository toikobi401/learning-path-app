# Database
DATABASE_URL="mysql://root:secret@localhost:3306/learning_path_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Encryption — 32-byte key (hex 64 ký tự hoặc base64) để mã hóa API key người dùng trong DB.
# Tạo: openssl rand -hex 32   (nếu bỏ trống, hệ thống tự derive từ NEXTAUTH_SECRET)
ENCRYPTION_KEY=""

# AI Providers — GROQ là provider mặc định + fallback hệ thống (BẮT BUỘC tối thiểu key này).
# https://console.groq.com/keys
GROQ_API_KEY=""

# Tùy chọn — key cấp hệ thống cho provider khác (user cũng có thể tự nhập trên UI Settings):
ANTHROPIC_API_KEY=""   # https://console.anthropic.com
OPENAI_API_KEY=""      # https://platform.openai.com/api-keys
GOOGLE_AI_API_KEY=""   # https://aistudio.google.com/app/apikey

# Cloudinary — avatar upload (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email — Gmail App Password (myaccount.google.com → Security → App passwords)
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="PathAI <your-gmail@gmail.com>"
