generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatar_url    String?
  password      String?
  emailVerified DateTime?
  image         String?
  provider      String    @default("email")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  goals                 Goal[]
  progress_logs         ProgressLog[]
  daily_checkins        DailyCheckin[]
  chat_messages         ChatMessage[]
  weekly_reviews        WeeklyReview[]
  phase_quiz_attempts   PhaseQuizAttempt[]
  practice_attempts     PracticeAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Goal {
  id            String     @id @default(cuid())
  user_id       String
  title         String
  description   String     @db.Text
  level         Level      @default(beginner)
  hours_per_day Float
  deadline      DateTime
  status        GoalStatus @default(active)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  learning_path  LearningPath?
  daily_checkins DailyCheckin[]
  chat_messages  ChatMessage[]
  weekly_reviews WeeklyReview[]
}

model LearningPath {
  id           String     @id @default(cuid())
  goal_id      String     @unique
  raw_json     Json
  total_weeks  Int
  status       PathStatus @default(draft)
  generated_at DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  goal   Goal    @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  phases Phase[]
}

model Phase {
  id          String @id @default(cuid())
  path_id     String
  title       String
  order_index Int

  path              LearningPath      @relation(fields: [path_id], references: [id], onDelete: Cascade)
  topics            Topic[]
  quiz              PhaseQuiz?
  practice_attempts PracticeAttempt[]
}

model Topic {
  id            String @id @default(cuid())
  phase_id      String
  title         String
  description   String @db.Text
  estimated_hrs Float
  week_number   Int
  order_index   Int

  phase         Phase         @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  resources     Resource[]
  progress_logs ProgressLog[]
}

model Resource {
  id       String         @id @default(cuid())
  topic_id String
  title    String
  url      String         @db.Text
  type     ResourceType
  source   ResourceSource @default(ai_suggested)

  topic Topic @relation(fields: [topic_id], references: [id], onDelete: Cascade)
}

model ProgressLog {
  id           String      @id @default(cuid())
  user_id      String
  topic_id     String
  status       TopicStatus @default(not_started)
  completed_at DateTime?
  note         String?     @db.Text
  updated_at   DateTime    @updatedAt

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([user_id, topic_id])
}

model DailyCheckin {
  id            String   @id @default(cuid())
  user_id       String
  goal_id       String
  date          DateTime @db.Date
  hours_studied Float
  mood          Mood     @default(good)
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goal_id], references: [id], onDelete: Cascade)

  @@unique([user_id, goal_id, date])
}

model ChatMessage {
  id         String      @id @default(cuid())
  user_id    String
  goal_id    String
  role       MessageRole
  content    String      @db.Text
  created_at DateTime    @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goal_id], references: [id], onDelete: Cascade)
}

// Phase quiz — permanent, auto-generated with the learning path
model PhaseQuiz {
  id         String         @id @default(cuid())
  phase_id   String         @unique
  difficulty QuizDifficulty @default(medium)
  created_at DateTime       @default(now())

  phase     Phase              @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  questions PhaseQuizQuestion[]
  attempts  PhaseQuizAttempt[]
}

model PhaseQuizQuestion {
  id            String       @id @default(cuid())
  quiz_id       String
  type          QuestionType
  question      String       @db.Text
  options       Json?        // string[4] for mcq only
  correct_index Int?         // mcq only
  model_answer  String?      @db.Text // essay grading reference
  explanation   String?      @db.Text // mcq explanation shown after submit
  order_index   Int

  quiz PhaseQuiz @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
}

model PhaseQuizAttempt {
  id           String   @id @default(cuid())
  quiz_id      String
  user_id      String
  answers      Json     // {index: number, chosen_index?: number, essay_text?: string}[]
  score        Float    // 0-100
  ai_feedback  Json     // {question, score, max_score, feedback}[]
  completed_at DateTime @default(now())

  quiz PhaseQuiz @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  user User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// Practice attempt — questions are temporary (state only), only score stored
model PracticeAttempt {
  id             String         @id @default(cuid())
  phase_id       String
  user_id        String
  difficulty     QuizDifficulty
  question_count Int
  question_types Json           // string[] e.g. ["mcq","essay"]
  score          Float
  ai_feedback    Json           // per-question feedback
  completed_at   DateTime       @default(now())

  phase Phase @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model WeeklyReview {
  id          String   @id @default(cuid())
  user_id     String
  goal_id     String
  week_number Int
  summary     String   @db.Text
  adjustments Json
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goal_id], references: [id], onDelete: Cascade)

  @@unique([user_id, goal_id, week_number])
}

enum Level {
  beginner
  intermediate
  advanced
}

enum GoalStatus {
  active
  paused
  completed
}

enum PathStatus {
  draft
  active
}

enum ResourceType {
  article
  video
  course
  doc
}

enum ResourceSource {
  ai_suggested
  user_added
}

enum TopicStatus {
  not_started
  in_progress
  completed
}

enum Mood {
  great
  good
  okay
  hard
}

enum MessageRole {
  user
  assistant
}

enum QuizDifficulty {
  easy
  medium
  hard
}

enum QuestionType {
  mcq
  essay
}
